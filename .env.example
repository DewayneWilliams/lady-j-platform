# Lady J Platform — local development only
# Copy to .env and fill values. Never commit .env.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=instance/ladyj.db

# Business
TIMEZONE=America/Port_of_Spain
DEPOSIT_PERCENT=50
BUSINESS_NAME=Lady J Salon & Day Spa
WHATSAPP_NUMBER=18683745517

# Bank transfer (displayed to clients; verification is manual)
BANK_NAME=First Citizens Bank
BANK_ACCOUNT_NAME=LADY J SALON AND DAY SPA
BANK_ACCOUNT_TYPE=Savings
BANK_ACCOUNT_NUMBER=3201297

# Card payments — leave unset to use simulated adapter (T&T support must be verified)
PAYMENT_CARD_PROVIDER=simulated
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional OAuth (disabled until credentials provided)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Optional AWS Maria integrations (local command fallback when unset)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=
# POLLY_VOICE_EN=Joanna
# POLLY_VOICE_ES=Lupe
# The same AWS credentials/instance role must allow translate:TranslateText.
# The public language picker never receives AWS keys.

# Exactly two production owners. Provision with the protected Flask CLI command.
OWNER_EMAILS=msjforde@gmail.com,dwetour@gmail.com

# Email delivery for secure password-reset links
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ladyjglobal.com
SMTP_USE_TLS=1